# The v2.4.2 backend clears 32 bytes in the error path of a 16-byte output.
# Compile a corrected copy in the build directory; leave the external SDK intact.
get_property(zephyr_libraries GLOBAL PROPERTY ZEPHYR_LIBS)
set(backend_found FALSE)
foreach(library IN LISTS zephyr_libraries)
  get_target_property(sources ${library} SOURCES)
  foreach(source IN LISTS sources)
    if(NOT source MATCHES "/fm_crypto_oberon[.]c$")
      continue()
    endif()
    set(backend_found TRUE)
    get_filename_component(backend_dir "${source}" DIRECTORY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" backend)
    string(FIND "${backend}" "int fm_crypto_derive_ltk(" start)
    if(start EQUAL -1)
      message(FATAL_ERROR "Unexpected Find My SDK interface. Use SDK v2.4.2.")
    endif()
    string(SUBSTRING "${backend}" ${start} -1 tail)
    string(FIND "${tail}" "\n}" end)
    string(SUBSTRING "${tail}" 0 ${end} body)
    if(body MATCHES "ocrypto_constant_time_fill_zero[(]out, 32[)]")
      string(REPLACE "ocrypto_constant_time_fill_zero(out, 32)" "ocrypto_constant_time_fill_zero(out, 16)" corrected "${body}")
      string(REPLACE "${body}" "${corrected}" backend "${backend}")
      set(fixed "${CMAKE_CURRENT_BINARY_DIR}/fm_crypto_oberon.c")
      file(WRITE "${fixed}" "${backend}")
      list(REMOVE_ITEM sources "${source}")
      list(APPEND sources "${fixed}")
      set_property(TARGET ${library} PROPERTY SOURCES "${sources}")
      target_include_directories(${library} PRIVATE "${backend_dir}")
    endif()
  endforeach()
endforeach()
if(NOT backend_found)
  message(FATAL_ERROR "Missing Nordic Find My v2.4.2 crypto backend.")
endif()
