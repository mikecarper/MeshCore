#include <zephyr/dt-bindings/adc/nrf-adc.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
  chosen {
    zephyr,console = &tag_usb;
    zephyr,shell-uart = &tag_usb;
    zephyr,code-partition = &tag_app;
  };
  buttons {
    compatible = "gpio-keys";
    tag_button: button { gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
  };
  buzzer {
    compatible = "pwm-leds";
    tag_buzzer: buzzer { pwms = <&pwm0 0 PWM_USEC(500) PWM_POLARITY_NORMAL>; };
  };
};

&flash0 {
  /delete-node/ partitions;
  partitions {
    compatible = "fixed-partitions";
    #address-cells = <1>;
    #size-cells = <1>;
    tag_app: partition@26000 { label = "image-0"; reg = <0x26000 0x9d000>; };
    storage_partition: partition@d2000 { label = "storage"; reg = <0xd2000 0x2000>; };
  };
};
&blue_led { gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; };
&green_led { gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>; };
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&spi1 { status = "disabled"; };
&qspi { status = "disabled"; };
&i2c1 { status = "disabled"; };

&zephyr_udc0 { tag_usb: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; }; };

&pinctrl {
  tag_i2c: tag_i2c { group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 25)>, <NRF_PSEL(TWIM_SCL, 0, 24)>; }; };
  tag_i2c_sleep: tag_i2c_sleep { group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 25)>, <NRF_PSEL(TWIM_SCL, 0, 24)>; low-power-enable; }; };
  tag_pwm: tag_pwm { group1 { psels = <NRF_PSEL(PWM_OUT0, 0, 21)>; }; };
  tag_pwm_sleep: tag_pwm_sleep { group1 { psels = <NRF_PSEL(PWM_OUT0, 0, 21)>; low-power-enable; }; };
};
&i2c0 {
  status = "okay";
  pinctrl-0 = <&tag_i2c>;
  pinctrl-1 = <&tag_i2c_sleep>;
};
&pwm0 {
  status = "okay";
  pinctrl-0 = <&tag_pwm>;
  pinctrl-1 = <&tag_pwm_sleep>;
  pinctrl-names = "default", "sleep";
};

&adc {
  #address-cells = <1>;
  #size-cells = <0>;
  channel@0 {
    reg = <0>;
    zephyr,gain = "ADC_GAIN_1_6";
    zephyr,reference = "ADC_REF_INTERNAL";
    zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
    zephyr,input-positive = <NRF_SAADC_AIN3>;
    zephyr,resolution = <12>;
  };
};
/ { zephyr,user { io-channels = <&adc 0>; }; };

#include <zephyr/dt-bindings/lora/sx126x.h>
&spi1 { status = "okay"; };
&lora {
  /delete-property/ tx-enable-gpios;
  /delete-property/ rx-enable-gpios;
  dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
};
&pinctrl {
  tag_gps: tag_gps { group1 { psels = <NRF_PSEL(UART_RX, 0, 15)>, <NRF_PSEL(UART_TX, 0, 16)>; }; };
  tag_gps_sleep: tag_gps_sleep { group1 { psels = <NRF_PSEL(UART_RX, 0, 15)>, <NRF_PSEL(UART_TX, 0, 16)>; low-power-enable; }; };
};
&uart0 {
  status = "okay";
  current-speed = <9600>;
  pinctrl-0 = <&tag_gps>;
  pinctrl-1 = <&tag_gps_sleep>;
};
