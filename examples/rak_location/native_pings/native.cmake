target_compile_definitions(app PRIVATE RAK_NATIVE_PINGS=1)
target_sources(app PRIVATE "${native}/main.c" "${native}/board.c")
if(RAK_FINDMY_PRODUCT_PLAN)
  if(NOT IS_ABSOLUTE "${RAK_FINDMY_PRODUCT_PLAN}" OR NOT EXISTS "${RAK_FINDMY_PRODUCT_PLAN}")
    message(FATAL_ERROR "Supply the absolute path to your Apple product plan C source")
  endif()
  target_compile_definitions(app PRIVATE RAK_FINDMY_HAS_PLAN=1)
  target_sources(app PRIVATE "${RAK_FINDMY_PRODUCT_PLAN}")
else()
  target_sources(app PRIVATE "${fmn}/src/unprovisioned.c")
endif()

# Adapt the pinned Nordic sample's application glue. Keep the native pairing,
# advertising, ownership and alert state machines from the installed SDK.
set(src "${locator}/src/main.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
file(READ "${src}" sample)
function(replace_sample old new)
  string(FIND "${sample}" "${old}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Unexpected Nordic locator sample. Use the pinned v3.3.0 release.")
  endif()
  string(REPLACE "${old}" "${new}" result "${sample}")
  set(sample "${result}" PARENT_SCOPE)
endfunction()
replace_sample("#define APP_BT_ID 1" "#define APP_BT_ID RAK_ANDROID_ID")
replace_sample("err = bt_enable(NULL);" "err = rak_host_ready();")
replace_sample("bt_gatt_authorization_cb_register(&gatt_authorization_callbacks)"
               "rak_register_android_gatt(&gatt_authorization_callbacks)")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/rak_locator_main.inc" CONTENT "${sample}" @ONLY)
target_include_directories(app PRIVATE "${locator}/src")
zephyr_link_libraries(-Wl,--wrap=settings_load)
include("${native}/../ping_monitor.cmake")
