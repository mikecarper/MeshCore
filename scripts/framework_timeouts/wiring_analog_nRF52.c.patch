+// Bound SAADC events even during early boot, before a scheduler tick is available.
+static bool waitForAdcEvent(volatile uint32_t *event)
+{
+  for (unsigned polls = 0; !*event; ++polls) {
+    if (polls == 10000) return false;
+    delayMicroseconds(2);
+  }
+  return true;
+}
+
+static void abortAdc(void)
+{
+  NRF_SAADC->EVENTS_STOPPED = 0;
+  NRF_SAADC->TASKS_STOP = 1;
+  (void)waitForAdcEvent(&NRF_SAADC->EVENTS_STOPPED);
+  NRF_SAADC->ENABLE = 0;
+  NRF_SAADC->RESULT.MAXCNT = 0;
+  NRF_SAADC->RESULT.PTR = 0;
+  NRF_SAADC->EVENTS_STARTED = 0;
+  NRF_SAADC->EVENTS_END = 0;
+  NRF_SAADC->EVENTS_STOPPED = 0;
+  NRF_SAADC->EVENTS_CALIBRATEDONE = 0;
+}
